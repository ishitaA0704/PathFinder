# .env.example – Pathfinder environment variable template
# Copy this file to .env and fill in your real values.
# The .env file is listed in .gitignore so your secret key is never committed.

# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Set to "true" to skip the Gemini API entirely and always use the local
# keyword classifier.  Useful for demos without internet or API quota.
FORCE_FALLBACK=false
