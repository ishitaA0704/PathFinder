{
 "manifest_version": 3,
 "name": "Pathfinder",
    "version": "1.0.0",
    "description": "A simple Chrome extension for blocking youtube videos",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "https://www.youtube.com/*"
    ],
    "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Focus - Pathfinder"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
        "run_at": "document_idle"
    }
  ],
    "background": {
        "service_worker": "background.js"
    }
}
